pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                // Replace 'bfc-backend' with your actual subfolder name
                dir('bfc') {
                    sh 'mvn clean compile -DskipTests'
                }
            }
        }

        stage('Tests') {
            steps {
                dir('bfc') {
                    sh 'mvn test'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('bfc') {
                    withSonarQubeEnv('SonarQube') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Package') {
            steps {
               dir('bfc') {
                    sh 'mvn package -DskipTests'
                }
            }
        }
    }
}
